# ═══════════════════════════════════════════════════════════
#  FIREBASE CONFIGURATION
#  Copiá este archivo como ".env" y completá tus credenciales.
#  Las encontrás en Firebase Console → Configuración del proyecto
#  → Tus apps → Web → Configuración del SDK.
#
#  Mientras dejes esto vacío, la app funciona con datos en memoria.
# ═══════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
